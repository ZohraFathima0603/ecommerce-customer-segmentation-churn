   ],
   "source": [
    "# 1. Define a snapshot date (1 day past the latest purchase in the data)\n",
    "snapshot_date = df['InvoiceDate'].max() + pd.Timedelta(days=1)\n",
    "print(f\"Analysis Snapshot Date: {snapshot_date.date()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "07e08d52-ad9d-4ad5-9e0b-f9230cdb1d75",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Group by Customer ID and aggregate metrics\n",
    "rfm = df.groupby('Customer ID').agg({\n",
    "    'InvoiceDate': lambda x: (snapshot_date - x.max()).days,  # Recency: days since last order\n",
    "    'Invoice': 'nunique',                                      # Frequency: total distinct orders\n",
    "    'TotalAmount': 'sum'                                       # Monetary: total spending\n",
    "}).reset_index()"
   ]
  },
