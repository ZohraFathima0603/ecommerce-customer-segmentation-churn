      "dtype: float64\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# 1. Inspect skewness before transformation\n",
    "print(\"Skewness before transformation:\")\n",
    "print(rfm[['Recency', 'Frequency', 'Monetary']].skew())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "228ab030-892b-4cb4-8c1a-0baec6aa3ff6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Apply log transformation (np.log1p avoids log(0) issues)\n",
    "rfm_log = np.log1p(rfm[['Recency', 'Frequency', 'Monetary']])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "fd6ae599-376f-4f28-a403-cb35fc0f297a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Scaled Data Preview:\n",
      "    Recency  Frequency  Monetary\n",
      "0  0.966262   1.613017 -0.540688\n",
      "1 -1.900165  -0.394693  0.447651\n",
      "2  0.355000  -0.981910 -0.943904\n",
      "3 -0.055302   0.021945  0.996204\n",
      "4 -1.054928  -0.981910 -0.707671\n"
     ]
    }
   ],
   "source": [
    "# 3. Standardize the data (mean=0, variance=1)\n",
    "scaler = StandardScaler()\n",
    "rfm_scaled = scaler.fit_transform(rfm_log)\n",
    "\n",
    "# Convert scaled array back to DataFrame for inspection\n",
    "rfm_scaled_df = pd.DataFrame(rfm_scaled, columns=['Recency', 'Frequency', 'Monetary'])\n",
    "print(\"\\nScaled Data Preview:\")\n",
    "print(rfm_scaled_df.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "789e5cea-6767-4ff8-a8ce-418ec17ac786",
   "metadata": {},
   "source": [
    "# Step 4: Find the Optimal Number of Clusters (k)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "a93d62d2-1844-4033-a0f9-b4c307287bec",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "k=2 | Silhouette Score: 0.4223\n",
      "k=3 | Silhouette Score: 0.3284\n",
      "k=4 | Silhouette Score: 0.3321\n",
      "k=5 | Silhouette Score: 0.3194\n",
      "k=6 | Silhouette Score: 0.3123\n",
      "k=7 | Silhouette Score: 0.3075\n",
      "k=8 | Silhouette Score: 0.2805\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score\n",
    "\n",
    "inertia = []\n",
    "silhouette_scores = []\n",
    "k_range = range(2, 9)\n",
    "\n",
    "for k in k_range:\n",
    "    kmeans = KMeans(n_clusters=k, init='k-means++', random_state=42, n_init=10)\n",
    "    kmeans.fit(rfm_scaled)\n",
    "    inertia.append(kmeans.inertia_)\n",
    "    score = silhouette_score(rfm_scaled, kmeans.labels_)\n",
    "    silhouette_scores.append(score)\n",
    "    print(f\"k={k} | Silhouette Score: {score:.4f}\")\n",
    "\n",
    "# Plot Elbow and Silhouette curves\n",
    "fig, ax1 = plt.subplots(figsize=(8, 4))\n",
    "\n",
    "color = 'tab:blue'\n",
    "ax1.set_xlabel('Number of Clusters (k)')\n",
    "ax1.set_ylabel('Inertia (SSE)', color=color)\n",
    "ax1.plot(k_range, inertia, 'bo-', label='Inertia')\n",
    "ax1.tick_params(axis='y', labelcolor=color)\n",
    "\n",
    "ax2 = ax1.twinx()\n",
    "color = 'tab:red'\n",
    "ax2.set_ylabel('Silhouette Score', color=color)\n",
    "ax2.plot(k_range, silhouette_scores, 'ro--', label='Silhouette Score')\n",
    "ax2.tick_params(axis='y', labelcolor=color)\n",
    "\n",
    "plt.title('Elbow Method & Silhouette Scores for Optimal k')\n",
    "plt.show()"
   ]
  },
